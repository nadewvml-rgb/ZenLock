<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrimary"
    android:paddingTop="60dp"
    android:paddingBottom="40dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".LockScreenActivity">

    <!--
        Layout structure (top to bottom, fixed):
          [mainContentContainer]  — scrollable, takes remaining space above apps
          [targetCountdownCard]   — fixed above apps
          [parentAppsContainer]  — fixed 220dp, scrollable grid
          [expandButtonContainer] — fixed at very bottom
    -->

    <!-- Main Content Container — scrollable so quote + buttons never overlap -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/targetCountdownCard">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Timer Container with Glow -->
            <FrameLayout
                android:id="@+id/timerContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_max="280dp"
                app:layout_constraintWidth_percent="0.7"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="40dp"
                android:background="@drawable/timer_glow_background">

                <!-- Default Timer (fallback) -->
                <TextView
                    android:id="@+id/timerCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="00:25"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:fontFamily="sans-serif-thin"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="36sp"
                    android:autoSizeMaxTextSize="64sp"/>

            </FrameLayout>

            <!-- Motivational Quote / Message -->
            <TextView
                android:id="@+id/lockscreenMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Stay focused, stay productive!"
                android:textSize="18sp"
                android:textColor="@color/textSecondary"
                android:fontFamily="sans-serif-light"
                android:lineSpacingMultiplier="1.3"
                android:gravity="center"
                android:maxLines="3"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/timerContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Hidden Unlock Arrow -->
            <ImageView
                android:id="@+id/unlockArrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_expand_more"
                android:background="@drawable/glass_card_inner"
                android:padding="8dp"
                android:contentDescription="Show unlock options"
                android:alpha="0.5"
                app:layout_constraintTop_toBottomOf="@id/lockscreenMessage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

            <!-- Unlock & Extend Buttons (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/unlockExtendButtonContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/unlockArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                android:alpha="0.0">

                <Button
                    android:id="@+id/unlockPromptButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlock"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@drawable/glass_button_background"
                    android:textColor="@color/white"
                    android:elevation="8dp" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/extendLockButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extend"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@drawable/glass_button_background"
                    android:textColor="@color/white"
                    android:elevation="8dp" />
            </LinearLayout>

            <!-- PIN Input (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/unlockInputsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/unlockArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <!-- PIN Input with Eye Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/pin_input_background"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/pinInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="Enter 4-digit PIN"
                        android:textColor="@color/white"
                        android:textColorHint="@color/textHint"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:background="@null"
                        android:padding="0dp"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:textCursorDrawable="@null"
                        android:letterSpacing="0.15"/>

                    <ImageView
                        android:id="@+id/pinVisibilityToggle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_eye"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:contentDescription="Toggle PIN visibility"
                        android:alpha="0.8"/>

                </LinearLayout>

                <Button
                    android:id="@+id/unlockButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirm Unlock"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@drawable/glass_button_background"
                    android:textColor="@color/white"
                    android:elevation="8dp"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Target Countdown Card — fixed between main content and apps -->
    <androidx.cardview.widget.CardView
        android:id="@+id/targetCountdownCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1A2235"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/parentAppsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:gravity="center">

            <TextView
                android:id="@+id/targetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#8899BB"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/targetCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="18sp"
                android:textColor="@color/textPrimary"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.04"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Parent Apps Container — fixed 220dp, scrollable inside -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parentAppsContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:layout_constraintBottom_toTopOf="@id/expandButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Apps RecyclerView — fills all 220dp, scrolls vertically -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/defaultAppsRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:nestedScrollingEnabled="true"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- No Apps Message -->
        <LinearLayout
            android:id="@+id/noAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_apps"
                android:alpha="0.4"
                app:tint="@color/textSecondary"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Apps Allowed"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All apps are currently blocked.\nConfigure allowed apps in Settings."
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:gravity="center"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Expand Button — always visible at bottom -->
    <LinearLayout
        android:id="@+id/expandButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/expandAppsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_expand_more"
            android:background="@drawable/circular_button"
            android:padding="10dp"
            android:contentDescription="Show apps"
            android:alpha="0.9"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
